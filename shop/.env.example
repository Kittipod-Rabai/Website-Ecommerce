# คัดลอกไฟล์นี้เป็น .env (หรือรัน `npm run setup` ให้สร้างให้อัตโนมัติ)

# ฐานข้อมูล SQLite สำหรับพัฒนา (ไม่ต้องติดตั้งอะไรเพิ่ม)
DATABASE_URL="file:./dev.db"

# คีย์เข้ารหัสการล็อกอิน — `npm run setup` จะสุ่มให้ ถ้าตั้งเองให้ใช้ข้อความสุ่มยาวๆ
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"

NEXT_PUBLIC_SITE_NAME="Maison Fleur"

# Stripe (โหมดทดสอบ) — เว้นว่างไว้ได้ ระบบจะใช้หน้า "จำลองชำระเงิน" แทนตอนพัฒนา
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- สำหรับเซิร์ฟเวอร์จริง (Render) — บนเครื่องพัฒนาไม่ต้องตั้ง ----
# ฐานข้อมูล PostgreSQL (Render ใส่ให้อัตโนมัติจาก render.yaml)
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# บัญชีแอดมินคนแรก (ใช้ตอน deploy ครั้งแรกเท่านั้น ตั้งรหัสผ่านอย่างน้อย 10 ตัวอักษร)
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD=""

# เก็บรูปสินค้าที่แอดมินอัปโหลด: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_URL=""

# เปิดหน้า "จำลองชำระเงิน" บนเซิร์ฟเวอร์จริงเพื่อสาธิต (ไม่หักเงินจริง) — ปิดอัตโนมัติเมื่อมีคีย์ Stripe
# ALLOW_MOCK_PAYMENT="true"
